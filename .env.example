# This file documents non-secret production Compose inputs. Copy its values to a
# protected host deployment file; do not commit that file or any API credential.

# Dedicated new-VPS runtime root. It must not be the Git checkout.
PRIMUS_HMD_RUNTIME_ROOT=/srv/primus/historical-market-data

# Explicit host identity that owns runtime storage/state/logs and runs collectors.
PRIMUS_HMD_COLLECTOR_UID=1000
PRIMUS_HMD_COLLECTOR_GID=1000

# Immutable image references. Replace these examples after B0 resolves and
# records the actual digest and release image ID.
PRIMUS_HMD_PYTHON_BASE_IMAGE=python:3.12-slim@sha256:d657ab0ade19f404a6ccc883ab399540de667aff751748ce23c07330c5a89e64
PRIMUS_HMD_IMAGE_REF=primus-historical-market-data:REPLACE_WITH_RELEASE_ID

# Protected, host-only env file injected into containers. It contains optional
# VNSTOCK_API_KEY, DNSE_API_KEY, DNSE_API_SECRET_KEY, and any future secrets.
PRIMUS_HMD_SECRETS_FILE=/srv/primus/historical-market-data/secrets/collector.env

# Do not add this to the protected deployment file until every B0 exit gate is
# passed and recorded. The image entrypoint refuses to start otherwise.
# PRIMUS_HMD_B0_APPROVED=approved
